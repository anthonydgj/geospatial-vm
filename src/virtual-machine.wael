export let VirtualMachine = (programGeometry) => (

    # Import libraries
    Use("stack.wael") With (Stack);
    Use("bytes.wael") With (Byte);
    Use("map.wael") With (Map);
    Use("list.wael") With (List);
    Use("util.wael") With (PipeIf);

    # Instruction codes
    let CODE_NOOP = 0;
    let CODE_PUSH = 1;
    let CODE_POP = 2;
    let CODE_ADD = 10;
    let CODE_SUBTRACT = 11;
    let CODE_MULTIPLY = 12;
    let CODE_DIVIDE = 13;
    let CODE_READ = 20; # TODO
    let CODE_JUMP = 21; # TODO
    let CODE_JUMP_IF_ZERO = 22; # TODO

    # Internal state
    let stack = Use(Stack());
    let instructions = GeometryCollection();
    programGeometry |* (p) => (instructions = instructions ++ p);
    let instPtr = 0;
    let currentInstCode = undefined;
    let previousInstCode = undefined;

    # Helper functions
    let UnaryOperator = (s, fn) => (a = s:pop(); s:push(fn(a)); s);
    let BinaryOperator = (s, fn) => (a = s:pop(); b = s:pop(); s:push(fn(a, b)); s);

    # Instruction implementations
    let Push = () => (
        let nextValue = readNext();
        nextValue = Math:abs(nextValue:y - nextValue:x);
        if (nextValue != undefined) then (
            stack:push(Byte(nextValue))
        ) else (
            undefined
        );
        nextValue
    ); 
    let Pop = () => (stack:pop());
    let IgnoreNext = () => (instPtr = instPtr + 1);
    let Noop = () => ();
    #let Add = () => (BinaryOperator(stack, (a, b) => (Byte(a + b))));
    #let Subtract = () => (BinaryOperator(stack, (a, b) => (Byte(b - a))));
    #let Multiply = () => (BinaryOperator(stack, (a, b) => (Byte(a * b))));
    #let Divide = () => (BinaryOperator(stack, (a, b) => (Byte(b / a))));

    # Instruction lookup
    let Instruction = (p) => (
        p 
            | PipeIf(p:x == 0 and p:y == 0, IgnoreNext)
            | PipeIf(p:x > 0 and p:y > 0, Push)
            | PipeIf(p:x < 0 and p:y < 0, Pop)
            | PipeIf(p:x == 0 and p:y > 0, Noop)
            | PipeIf(p:x > 0 and p:y == 0, Noop)
            | PipeIf(p:x == 0 and p:y < 0, Noop)
            | PipeIf(p:x < 0 and p:y == 0, Noop)
            | PipeIf(p:x > 0 and p:y < 0, Noop)
            | PipeIf(p:x < 0 and p:y > 0, Noop)
            | PipeIf((v) => (v == code), Noop)
    );

    # Peek the next instruction
    let peekNext = () => (
        let instCode = instructions:geometryN(instPtr);
        instCode
    );

    # Read the next instruction
    let readNext = () => (
        let instCode = peekNext();
        instPtr = instPtr + 1;
        instCode
    );

    # Execute the next instruction 
    export let step = () => (
        let currentPoint = currentInstCode;
        let previousPoint = previousInstCode;
        if ((previousPoint == undefined) or (currentPoint == undefined)) then (false) else (
            let relativeInstruction = currentPoint - previousPoint;
            let instruction = Instruction(relativeInstruction);
            if (instruction != undefined) then (instruction()) else (false)
        );
        undefined
    );

    # Process all instructions
    export let start = () => (
        # Loop until program is done
        (i => (currentInstCode = readNext(); currentInstCode != undefined)) >>
            (i => (step(); previousInstCode = currentInstCode))
    );

    # Default 
    () => (stack())
);
