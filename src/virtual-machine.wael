export let VirtualMachine = (programGeometry) => (

    # Import libraries
    Use("stack.wael") With (Stack);
    Use("bytes.wael") With (Byte);
    Use("map.wael") With (Map);
    Use("list.wael") With (List);
    Use("util.wael") With (PipeIf);

    # Internal state
    let stack = Use(Stack());
    let instructions = GeometryCollection();
    programGeometry |* (p) => (instructions = instructions ++ p);
    let instPtr = 0;
    let currentInstCode = undefined;
    let previousInstCode = undefined;

    # Helper functions
    let UnaryOperator = (s, fn) => (a = s:pop(); s:push(fn(a)); s);
    let BinaryOperator = (s, fn) => (a = s:pop(); b = s:pop(); s:push(fn(a, b)); s);
    let ReadLiteral = (s, fn) => (
        let nextValue = readNext();
        # Value is the absolute difference between x and y coordinates
        if (nextValue == undefined) then (nextValue) else (
            Math:abs(nextValue:y - nextValue:x)
        )
    );

    # Instruction implementations
    let Push = () => (
        let nextValue = ReadLiteral();
        if (nextValue != undefined) then (
            stack:push(Byte(nextValue))
        ) else (
            undefined
        );
        nextValue
    ); 
    let Drop = () => (stack:pop());
    let Dup = () => (stack:push(stack:peek()));
    let Swap = () => (let a = stack:pop(); let b = stack:pop(); stack:push(a); stack:push(b));
    let Add = () => (BinaryOperator(stack, (a, b) => (Byte(a + b))));
    let Sub = () => (BinaryOperator(stack, (a, b) => (Byte(b - a))));
    let Jump = () => (
        let ptr = ReadLiteral();
        currentInstCode = undefined;
        previousInstCode = undefined;
        instPtr = ptr
    );
    let JumpIfZero = () => (
        let value = stack:pop();
        if (value == 0) then (
            Jump()
        ) else (
            instPtr = instPtr + 1   # Skip ptr
        )
    );
    let IgnoreNext = () => (instPtr = instPtr + 1);
    let Noop = () => ();

    # Instruction lookup
    let Instruction = (delta) => (
        delta 
            | PipeIf(delta:x == 0 and delta:y == 0, IgnoreNext) 
            | PipeIf(delta:x > 0 and delta:y > 0,   Push)       
            | PipeIf(delta:x < 0 and delta:y < 0,   Drop)       
            | PipeIf(delta:x == 0 and delta:y > 0,  Dup)        
            | PipeIf(delta:x > 0 and delta:y == 0,  Swap)       
            | PipeIf(delta:x == 0 and delta:y < 0,  Add)        
            | PipeIf(delta:x < 0 and delta:y == 0,  Sub)        
            | PipeIf(delta:x > 0 and delta:y < 0,   JumpIfZero) 
            | PipeIf(delta:x < 0 and delta:y > 0,   Jump)       
            | PipeIf((v) => (v == delta), Noop)
    );

    # Peek the next instruction
    let peekNext = () => (
        let instCode = instructions:geometryN(instPtr);
        instCode
    );

    # Read the next instruction
    let readNext = () => (
        let instCode = peekNext();
        instPtr = instPtr + 1;
        previousInstCode = currentInstCode;
        currentInstCode = instCode;
        instCode
    );

    # Execute the next instruction 
    export let step = () => (
        let currentPoint = currentInstCode;
        let previousPoint = previousInstCode;
        if ((previousPoint == undefined) or (currentPoint == undefined)) then (undefined) else (
            let relativeInstruction = currentPoint - previousPoint;
            let instruction = Instruction(relativeInstruction);
            if (instruction != undefined) then (instruction(); undefined) else (false)
        )
    );

    # Process all instructions
    export let start = () => (
        # Loop until program is done
        (i => (readNext(); currentInstCode != undefined)) >>
            (i => (if (step() == false)
                then (currentInstCode = undefined)
                else (undefined)))
    );

    # Default 
    () => (stack())
);
